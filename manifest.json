{
  "manifest_version": 3,
  "name": "explain-this",
  "version": "1.0",
  "description": "Select text on any page and get AI-powered explanation.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup-dist/index.html"
  },
  "options_page": "options/index.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
